# Checks for a new Fetch release once a day, at a random time so not every
# hub asks GitHub at the same moment.
#   systemctl enable --now fetch-hub-update.timer     # turn on
#   systemctl disable --now fetch-hub-update.timer    # turn off
[Unit]
Description=Daily update check for the Fetch hub

[Timer]
OnCalendar=daily
RandomizedDelaySec=6h
Persistent=true

[Install]
WantedBy=timers.target
